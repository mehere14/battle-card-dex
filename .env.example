# Safe placeholders only. Put real values in the macOS Keychain or CI secret store.
BATTLE_CARD_DEX_CARD_SOURCE_API_KEY=<optional-card-source-key>
BATTLE_CARD_DEX_CLOUDKIT_KEY_ID=<cloudkit-server-key-id>
BATTLE_CARD_DEX_CLOUDKIT_PRIVATE_KEY_PATH=/absolute/path/outside/repository/cloudkit-private-key.p8

# Optional separate destination credentials for promote-production only.
BATTLE_CARD_DEX_PRODUCTION_CLOUDKIT_KEY_ID=<production-server-key-id>
BATTLE_CARD_DEX_PRODUCTION_CLOUDKIT_PRIVATE_KEY_PATH=/absolute/path/outside/repository/production-key.pem

BATTLE_CARD_DEX_CLOUDKIT_CONTAINER_IDENTIFIER=iCloud.com.example.BattleCardDex
